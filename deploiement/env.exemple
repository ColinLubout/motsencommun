# Réglages de Mots en commun sur le serveur.
#
# Copier ce fichier vers /etc/motsencommun/env (propriétaire root, groupe
# motsencommun, mode 0640), puis remplir les valeurs. Le fichier rempli
# contient des secrets : il ne doit jamais être committé ni copié ailleurs.
#
# Une variable obligatoire laissée vide empêche le site de démarrer, avec un
# message qui la nomme.

# Clé secrète de Django : au moins 50 caractères aléatoires, propres à ce serveur.
# Pour en tirer une au hasard :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Mode de débogage : toujours 0 sur le serveur. 1 sert seulement en développement local.
DJANGO_DEBUG=0

# Noms de domaine servis par Django, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=motsencommun.fr

# Chemin de l'administration, sans « / » au début : difficile à deviner, jamais « admin/ ».
# Pour en tirer un au hasard :
#   uv run python -c "import secrets; print('gestion-' + secrets.token_hex(6) + '/')"
CHEMIN_ADMIN=

# Dossier, en chemin absolu, où le site écrit sa base SQLite et ses fichiers.
DOSSIER_DONNEES=/srv/motsencommun/donnees

# Dossier, en chemin absolu, où « manage.py exporter » écrit les fichiers à
# télécharger (et leurs instantanés mensuels, dans instantanes/AAAA-MM/).
DOSSIER_TELECHARGEMENTS=/srv/motsencommun/telechargements
